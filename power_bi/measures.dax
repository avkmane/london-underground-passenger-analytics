Total Entries = SUM(FactHourlyFlow[entries])
Total Exits = SUM(FactHourlyFlow[exits])
Total Passenger Flow = SUM(FactHourlyFlow[total_flow])
Net Arrivals = SUM(FactHourlyFlow[net_arrivals])
AM Peak Flow = CALCULATE([Total Passenger Flow], FactHourlyFlow[time_band] = "am_peak")
PM Peak Flow = CALCULATE([Total Passenger Flow], FactHourlyFlow[time_band] = "pm_peak")
Entry Exit Ratio = DIVIDE([Total Entries], [Total Exits])
Anomalous Stations = CALCULATE(DISTINCTCOUNT(DimStationMetrics[Station]), DimStationMetrics[is_anomaly] = TRUE())
Employment Destination Stations = CALCULATE(DISTINCTCOUNT(DimStationMetrics[Station]), DimStationMetrics[segment] = "Employment-destination")
